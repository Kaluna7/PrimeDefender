PORT=3000

# Default false: POST /ingest tidak akan broadcast sampai Anda set true (middleware siap).
INGEST_ENABLED=false

# Set true saat middleware Anda akan mengirim insiden nyata
# INGEST_ENABLED=true

# ADMIN_SECRET=long-random-for-dashboard-key-management
# INGEST_TOKEN=legacy-shared-secret
# API_KEYS_FILE=./data/api-keys.json

# MongoDB (incidents persisted on each POST /ingest)
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=slark
# MONGODB_COLLECTION=incidents
# MONGODB_DISABLED=true

# Dashboard: GET /admin/incidents/recent and /admin/incidents/history (header X-Admin-Secret)

# Google OAuth + Hostinger SMTP email verification (/signin)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# FRONTEND_URL=http://localhost:5173
# AUTH_SESSION_SECRET=long-random-string
# AUTH_SESSION_HOURS=24
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@no-reply-information.tech
# SMTP_PASS=your-email-password
# SMTP_SENDER_EMAIL=you@no-reply-information.tech
# SMTP_SENDER_NAME=Slark

# Midtrans Snap (subscription purchase page)
# MIDTRANS_MERCHANT_ID=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION=false

# Subscriptions require MongoDB (users + orders collections)
# MONGODB_DISABLED=false
